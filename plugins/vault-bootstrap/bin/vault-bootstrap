#!/usr/bin/env bash
# Launcher: runs vault_bootstrap.py with whichever Python 3 is installed. Never fails a hook.
d="$(cd "$(dirname "$0")" && pwd)"
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then
    exec "$py" "$d/vault_bootstrap.py" "$@"
  fi
done
echo "vault-bootstrap: Python 3.8 or newer not found" >&2
exit 0
